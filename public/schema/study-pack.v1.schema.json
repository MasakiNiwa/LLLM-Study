{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lllm-study-pack",
      "description": "固定値 \"lllm-study-pack\""
    },
    "version": {
      "type": "number",
      "const": 1,
      "description": "形式のバージョン（固定値 1）"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "パックの ID（同じ ID で取り込むと更新として扱う）"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "subject": {
      "description": "分野（例: english, history, programming）",
      "type": "string",
      "maxLength": 40
    },
    "language": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "description": "学ぶ言語（BCP 47。例: en）"
        },
        "explanation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "description": "説明に使う言語（BCP 47。例: ja）"
        }
      },
      "required": [
        "target",
        "explanation"
      ],
      "additionalProperties": false
    },
    "level": {
      "description": "難易度の目安（例: CEFR A2, 中学）",
      "type": "string",
      "maxLength": 40
    },
    "tags": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "author": {
      "type": "string",
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "maxLength": 100
    },
    "source": {
      "description": "作り方・出典（例: Generated by AI）",
      "type": "string",
      "maxLength": 300
    },
    "revision": {
      "description": "パックの版。更新するたびに増やす",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "items": {
      "minItems": 1,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "vocab"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "パック内で一意な ID（更新時に学習記録を引き継ぐキー。後から変えない）"
              },
              "tags": {
                "description": "分類用のタグ",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "notes": {
                "description": "補足・語法・注意点など",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "見出し語"
              },
              "reading": {
                "description": "発音記号（IPA）や読み方",
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "pos": {
                "description": "品詞（例: 動詞, 名詞）",
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "meanings": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "description": "意味（説明の言語）。主要なものから順に"
              },
              "examples": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "例文（学ぶ言語）"
                    },
                    "translation": {
                      "description": "例文の訳（説明の言語）",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "例文"
                }
              },
              "collocations": {
                "description": "よく使う組み合わせ",
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "synonyms": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "antonyms": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": [
              "type",
              "id",
              "term",
              "meanings"
            ],
            "additionalProperties": false,
            "description": "単語カード"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "phrase"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "パック内で一意な ID（更新時に学習記録を引き継ぐキー。後から変えない）"
              },
              "tags": {
                "description": "分類用のタグ",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "notes": {
                "description": "補足・語法・注意点など",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "phrase": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "フレーズ・表現"
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "意味（説明の言語）"
              },
              "situation": {
                "description": "使う場面",
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "examples": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "例文（学ぶ言語）"
                    },
                    "translation": {
                      "description": "例文の訳（説明の言語）",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "例文"
                }
              }
            },
            "required": [
              "type",
              "id",
              "phrase",
              "meaning"
            ],
            "additionalProperties": false,
            "description": "フレーズカード"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "qa"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "パック内で一意な ID（更新時に学習記録を引き継ぐキー。後から変えない）"
              },
              "tags": {
                "description": "分類用のタグ",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "notes": {
                "description": "補足・語法・注意点など",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "問題"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "答え"
              },
              "explanation": {
                "description": "解説",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "hints": {
                "description": "ヒント（弱いものから順に）",
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": [
              "type",
              "id",
              "question",
              "answer"
            ],
            "additionalProperties": false,
            "description": "一問一答カード"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "cloze"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "パック内で一意な ID（更新時に学習記録を引き継ぐキー。後から変えない）"
              },
              "tags": {
                "description": "分類用のタグ",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "notes": {
                "description": "補足・語法・注意点など",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "穴にする部分を {{ }} で囲んだ文。例: I look {{forward}} to seeing you."
              },
              "translation": {
                "description": "文全体の訳",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "additionalProperties": false,
            "description": "穴埋めカード"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "choice"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "パック内で一意な ID（更新時に学習記録を引き継ぐキー。後から変えない）"
              },
              "tags": {
                "description": "分類用のタグ",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "notes": {
                "description": "補足・語法・注意点など",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "問題"
              },
              "choices": {
                "minItems": 2,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "description": "選択肢"
              },
              "answer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "正解の選択肢の番号（0 始まり）"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "type",
              "id",
              "question",
              "choices",
              "answer"
            ],
            "additionalProperties": false,
            "description": "選択問題カード"
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "title",
    "items"
  ],
  "additionalProperties": false,
  "description": "ローカルLLM学習アプリの教材パック"
}
